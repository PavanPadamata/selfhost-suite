# Copy to .env and fill in real values.

# Nextcloud database
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=CHANGE_ME
MYSQL_HOST=nextcloud_db
MARIADB_VERSION=11.4

# Nextcloud app
NEXTCLOUD_VERSION=31
NEXTCLOUD_PORT=8181
NEXTCLOUD_DATA_VOLUME=./nextcloud_data
NEXTCLOUD_DB_VOLUME=./nextcloud_db_data
OVERWRITEPROTOCOL=https
REDIS_HOST=redis
REDIS_CONTAINER_NAME=nextcloud_redis

# OnlyOffice
ONLYOFFICE_PORT=8282
ONLYOFFICE_DB_HOST=onlyoffice_db
ONLYOFFICE_DB_PORT=5432
ONLYOFFICE_DB_NAME=onlyoffice
ONLYOFFICE_DB_USER=onlyoffice
ONLYOFFICE_DB_PASS=CHANGE_ME
ONLYOFFICE_DB_VOLUME=./onlyoffice_db_data
