# Copy to .env and fill in real values.
DOMAIN=https://vault.example.com

# Generate an Argon2 hash with:
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# and keep it in single quotes so the $ characters are not interpolated.
ADMIN_TOKEN=CHANGE_ME

# Email domains (not hostnames) that may sign up when SIGNUPS_VERIFY is on.
SIGNUPS_DOMAINS_WHITELIST=example.com

SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=info@example.com
SMTP_FROM_NAME=Vaultwarden
SMTP_USERNAME=info@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_AUTH_MECHANISM=Login
